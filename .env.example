# Cesium Ion Access Token (optional - app runs offline without it)
# Get free token from: https://ion.cesium.com/
CESIUM_TOKEN=

# NASA FIRMS API Key (free - enables satellite fire detection)
# Get free key from: https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# NASA API Key (free - optional, falls back to DEMO_KEY)
NASA_API_KEY=DEMO_KEY

# Unsplash Access Key (free - 50 req/hr demo, 5k prod)
# Get from: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# OSIRIS (merged) — native /api/osiris/* works without separate server
# Optional: run upstream OSIRIS Next.js on :4000 for live AIS + full CCTV coverage, then Global Earth proxies to it as fallback
# Upstream: https://github.com/simplifaisoul/osiris
OSIRIS_URL=http://localhost:4000
# Optional AIS key for live ships (otherwise ports/chokepoints static only)
AIS_API_KEY=
