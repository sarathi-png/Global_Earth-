# MapLibre GL needs no token (OSIRIS engine + CARTO dark-matter basemap).
# Globe runs fully keyless on static hosting.

# NASA FIRMS API Key (free - enables satellite fire detection)
# Get free key from: https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# NASA API Key (free - optional, falls back to DEMO_KEY)
NASA_API_KEY=DEMO_KEY

# Unsplash Access Key (free - 50 req/hr demo, 5k prod)
# Get from: https://unsplash.com/developers
# NOTE: fully-static hosting has no secret proxy. Prefer leaving this empty
# (Wikipedia/Wikimedia/canvas fallbacks) or pass ?unsplash_key= at runtime.
UNSPLASH_ACCESS_KEY=

# Static hosting: no server-side keys are used at runtime.
# Optional client keys via URL params: ?firms_key=...&mapillary_key=...
# Map style override: ?map_style=<style.json URL>
# Reference live app (external, no integration): https://osirisai.live/
